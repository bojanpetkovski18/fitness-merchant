# Copy to .env and fill in. Never commit .env.
# Placeholders only. Variables are added here by the milestone that introduces them.

# --- Database (docker-compose and API) ---
POSTGRES_DB=fitness_merchant
POSTGRES_USER=fitness_merchant
POSTGRES_PASSWORD=change-me
# Host port for the dev database (docker-compose.dev.yml).
POSTGRES_PORT=5433
# Used by the API; the host is "db" inside docker compose; on the host use localhost and POSTGRES_PORT.
ConnectionStrings__Database=Host=localhost;Port=5433;Database=fitness_merchant;Username=fitness_merchant;Password=change-me

# --- App ---
ASPNETCORE_ENVIRONMENT=Development
Database__MigrateOnStartup=true
Seed__Enabled=true

# --- Demo users (seeded only if set). Passwords need 10+ chars with upper, lower, digit and symbol. ---
DEMO_ADMIN_EMAIL=admin@fitness-merchant.example
DEMO_ADMIN_PASSWORD=Change-Me-Admin-1
DEMO_CUSTOMER_EMAIL=customer@fitness-merchant.example
DEMO_CUSTOMER_PASSWORD=Change-Me-Customer-1

# --- Demo mode (deployed demo only) ---
DEMO_MODE=false
DEMO_RESET_INTERVAL_HOURS=6

# --- Payments: Fake | Stripe ---
Payments__Provider=Fake
# Test-mode keys from your Stripe dashboard (they start with sk_test_ and whsec_). Leave empty with the Fake provider.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Rate limiting (optional; defaults shown) ---
# RateLimiting__AuthPermitLimit=10
# RateLimiting__AuthWindowSeconds=60

# Reverse proxy (K5): only set when the API runs behind one, so per-IP rate limits see real clients.
# Requests from these addresses may set X-Forwarded-For/Proto; otherwise the headers are ignored.
# ReverseProxy__KnownProxies=10.0.0.5
# ReverseProxy__KnownNetworks=10.0.0.0/8
